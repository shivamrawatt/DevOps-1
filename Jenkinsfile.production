pipeline {
    agent any


    parameters {
    string(
        name: 'DOCKER_IMAGE',
        defaultValue: 'rrajivsingh/devops-1-app',
        description: 'Docker Hub image repository'
    )

    string(
        name: 'DOCKER_TAG',
        defaultValue: '',
        description: 'Docker image tag supplied by CI'
    )
}

    stages {
        stage('Validate Configuration') {
            steps {
                echo 'Validating production deployment configuration'

                sh '''
                    command -v ssh
                    command -v scp
                '''
            }
        }

        

        stage('Deploy to EC2') {
            steps {
                withCredentials([
              
                    string(
                        credentialsId: 'ec2-public-ip',
                        variable: 'EC2_HOST'
                    ),
                    file(
                        credentialsId: 'devops-1-prod-env',
                        variable: 'ENV_FILE'
                    )
                ]) {
                    sshagent(credentials: ['ec2-ssh-key']) {
                        sh '''
                            set -eu

                         IMAGE="${DOCKER_IMAGE}:${DOCKER_TAG}"
                            REMOTE="ubuntu@${EC2_HOST}"
                            ENV_PATH="/home/ubuntu/devops-1-prod.env"

                            echo "Checking Docker network..."

                            ssh -o StrictHostKeyChecking=accept-new "$REMOTE" \
                                "docker network inspect devops-1-network >/dev/null"

                            echo "Transferring production environment file..."

                            scp -o StrictHostKeyChecking=accept-new \
                                "$ENV_FILE" "$REMOTE:$ENV_PATH"

                            ssh -o StrictHostKeyChecking=accept-new "$REMOTE" \
                                "chmod 600 '$ENV_PATH'"

                            echo "Starting remote deployment..."

                            ssh -o StrictHostKeyChecking=accept-new "$REMOTE" \
                                "bash -s -- '$IMAGE' '$ENV_PATH'" <<'REMOTE_SCRIPT'
set -u

IMAGE="$1"
ENV_PATH="$2"

# Save the exact image used by the existing container.
PREVIOUS_IMAGE=$(docker inspect \
    --format='{{.Image}}' DevOps-1-app 2>/dev/null || true)

if [ -z "$PREVIOUS_IMAGE" ]; then
    echo "ERROR: No previous application image found."
    echo "Deployment stopped because rollback cannot be guaranteed."
    rm -f "$ENV_PATH"
    exit 1
fi

echo "Previous image saved: $PREVIOUS_IMAGE"

rollback() {
    echo "Deployment failed. Starting automatic rollback..."

    docker rm -f DevOps-1-app || true

    if ! docker run -d \
        --name DevOps-1-app \
        --restart unless-stopped \
        --network devops-1-network \
        --env-file "$ENV_PATH" \
        -p 5000:5000 \
        "$PREVIOUS_IMAGE"; then

        echo "ERROR: Failed to start previous image."
        rm -f "$ENV_PATH"
        exit 1
    fi

    echo "Checking restored application health..."

    for i in $(seq 1 12); do
        if curl --connect-timeout 2 --max-time 5 -fsS \
            http://localhost:5000/api/health; then

            echo "ROLLBACK SUCCESSFUL."
            echo "Previous version has been restored."

            rm -f "$ENV_PATH"

            # Rollback succeeded, but the new deployment failed.
            exit 1
        fi

        echo "Rollback health attempt $i failed."
        sleep 5
    done

    echo "ERROR: Rollback health check failed."
    docker logs --tail 50 DevOps-1-app || true

    rm -f "$ENV_PATH"
    exit 1
}

echo "Pulling new Docker image..."

if ! docker pull "$IMAGE"; then
    echo "ERROR: Failed to pull the new image."
    rm -f "$ENV_PATH"
    exit 1
fi

echo "Removing existing application container..."

docker rm -f DevOps-1-app || true

echo "Starting new application container..."

if ! docker run -d \
    --name DevOps-1-app \
    --restart unless-stopped \
    --network devops-1-network \
    --env-file "$ENV_PATH" \
    -p 5000:5000 \
    "$IMAGE"; then

    echo "ERROR: New container failed to start."
    rollback
fi

echo "Checking new application health..."

for i in $(seq 1 5); do
    if curl --connect-timeout 2 --max-time 4 -fsS \
        http://localhost:5000/api/health; then

        echo "Health check passed."
        echo "New deployment is healthy."

        rm -f "$ENV_PATH"
        exit 0
    fi

    echo "Health check attempt $i failed."
    sleep 5
done

echo "New deployment failed its health check."
docker logs --tail 50 DevOps-1-app || true

rollback
REMOTE_SCRIPT

                            echo "Displaying application logs..."

                            ssh -o StrictHostKeyChecking=accept-new "$REMOTE" \
                                "docker logs --tail 50 DevOps-1-app"

                            echo "Production deployment completed."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Production CD pipeline completed successfully.'
        }

        failure {
            echo 'Production deployment failed. Check the Jenkins console output.'
        }

        always {
            echo 'Production CD execution finished.'
        }
    }
}